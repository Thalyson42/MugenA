+/* MUGEN-UNLEASHED PATCH: Elecbyte's modified SDL_mixer also reports the chunk size (samples per mixing
+ * callback); the engine calls this in Sound_Init (third_party/sdk/def/SDL_mixer.def). */
+int Mix_QuerySpecEx(int *frequency, Uint16 *format, int *channels, int *chunksize)
+{
+	if ( audio_opened ) {
+		if ( frequency ) {
+			*frequency = mixer.freq;
+		}
+		if ( format ) {
+			*format = mixer.format;
+		}
+		if ( channels ) {
+			*channels = mixer.channels;
+		}
+		if ( chunksize ) {
+			*chunksize = mixer.samples;
+		}
+	}
+	return(audio_opened);
+}
